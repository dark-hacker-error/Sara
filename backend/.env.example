# Copy to .env and fill in. The app can also push per-subagent config at runtime over the
# WebSocket, in which case only GEMINI_API_KEY is strictly required here.

# --- Gemini (used by the orchestrator, and by any subagent set to GEMINI_NATIVE) ----------
GEMINI_API_KEY=
# Or, for Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Orchestrator (the root agent that plans and delegates) -------------------------------
# A plain Gemini text model. Live models are for the voice session on the phone, not for the
# planning loop here.
SARA_ORCHESTRATOR_MODEL=gemini-3.8-flash

# --- Server -----------------------------------------------------------------------------
SARA_HOST=0.0.0.0
SARA_PORT=8000

# Optional: pre-seed a subagent so the app has something working before the user edits
# anything. Format is JSON; values here are defaults only and are replaced by whatever the
# app pushes on connect.
# SARA_DEFAULT_PHONE_AGENT_MODEL=
# SARA_DEFAULT_RESEARCH_AGENT_MODEL=
