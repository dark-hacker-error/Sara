<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service config.
  - canRetrieveWindowContent: read the UI tree (needed to find nodes by text/id).
  - canPerformGestures: dispatchGesture for tap / long-press / swipe / scroll.
  - flags: report view ids + text, and include non-important views so we can see
    clickable parents that hold no text of their own.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.sara.assistant.MainActivity" />
